<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.emlab.daily-fev-library</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/scripts/start_emlab.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- KeepAlive=true relaunches the watcher on any exit, including a crash,
       so ingestion recovers automatically. ThrottleInterval caps the relaunch
       rate so a hard crash-loop backs off instead of hammering the machine. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/emlab.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/emlab.err.log</string>
</dict>
</plist>
