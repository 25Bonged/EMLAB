# ── Dependencies / build artifacts (regenerated per machine) ──
node_modules/
**/node_modules/
.venv/
backend/.venv/
__pycache__/
**/__pycache__/
dist/
dist-ssr/
*.egg-info/

# ── Confidential emission data — NEVER commit ──
# Real OEM/FEV test reports, compiled results, and the database built from them.
# These live on the engineering machines, not in source control.
OneDrive_*/
*.xlsm
STLA_Emission_Result_Compile.xlsx
backend/data/
# Personal study material — contains real AIS-175 result-sheet PDFs.
AIS175_Study/
dashboard/data/
**/emissions.db
# SQLite writes -wal/-shm sidecars alongside the db. They carry the same
# confidential rows, and a hyphen is not matched by `emissions.db.*`.
**/emissions.db-*
**/emissions.db.*
outputs/
.workbook_inspection/

# ── Logs ──
logs/
*.log
backend/logs/

# ── OS / editor cruft ──
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── Local env / secrets ──
*.local
.env
.env.*

# root node_modules is a symlink into a runtime cache — never track it
/node_modules

# ── Isolated worktrees for parallel/background agent work ──
.worktrees/
